# Copy to .env and generate a key before running `docker compose up`:
#   openssl rand -hex 32
# The API refuses to start in Production without a unique JWT key of 32+ characters.

JWT_KEY=

# Reverse-proxy trust (needed for per-IP login rate limiting behind nginx/Caddy).
# Set exactly the proxy addresses or private network that forwards X-Forwarded-For.
# Example: PROXY_KNOWN_PROXIES=172.18.0.5   or   PROXY_KNOWN_NETWORKS=172.16.0.0/12
# PROXY_KNOWN_PROXIES=
# PROXY_KNOWN_NETWORKS=

# Email workers (mailboxes themselves are configured in Settings → Email).
# EMAIL_DISPATCHER_ENABLED=true
# EMAIL_INBOUND_ENABLED=true
# EMAIL_DISPATCH_INTERVAL_SECONDS=15
# EMAIL_INBOUND_INTERVAL_MINUTES=2

# Host ports (change if 3000/5080 are already in use)
# WEB_PORT=3000
# API_PORT=5080
